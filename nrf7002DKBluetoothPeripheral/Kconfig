source "Kconfig.zephyr"

menu "My BLE GATT service sample"

# My Service configuration
config BT_MY_SERVICE
	bool "Enable My Service"
	select BT
	help
	  Enable My Service

config BT_MY_SERVICE_POLL_BUTTON
	bool "Enable polling of the button state"
	depends on BT_MY_SERVICE
	help
	  Enable periodic polling of the button state.

config BT_MY_SERVICE_SECURITY_ENABLED
	bool "Enable security for My Service"
	depends on BT_MY_SERVICE
	select BT_SMP
	select BT_SETTINGS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select ZMS if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	select NVS if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	select SETTINGS
	help
	  Enable security for My Service.

endmenu
