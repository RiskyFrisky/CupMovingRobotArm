void setup() {
  pinMode(LED_BUILTIN, OUTPUT);      // set LED pin as output
  digitalWrite(LED_BUILTIN, LOW);    // switch off LED pin

  Serial.begin(9600);

  // Set Serial1 parameters manually
  Serial1.begin(115200);  // Set baud rate to 115200
  
  // // Apply custom settings for the UART
  // // HardwareSerial (Serial1) setup using low-level registers
  // Serial1.setTimeout(100);  // Set read timeout if needed (in milliseconds)

  // // You can add specific settings below if you have direct access to registers:
  // // For Arduino, you'll need to access the UART registers for low-level changes.
  // // The following is an example on Arduino Uno (you can adjust based on the specific board):
  
  // // Disable parity
  // UCSR1C &= ~(_BV(UPM10) | _BV(UPM11)); // Clear Parity
  // UCSR1C &= ~(_BV(UCSZ10) | _BV(UCSZ11)); // Set data bits to 8
  // UCSR1C |= _BV(UCSZ11); // Set data bits to 8 (8-bit data)
  
  // // Set stop bits to 1 (by default, it's already 1 on most boards)
  // UCSR1C &= ~_BV(USBS1); // 1 stop bit
  
  // // Enable UART1 (this is mostly done with Serial1.begin)
  // UCSR1B |= _BV(TXEN1) | _BV(RXEN1); // Enable TX and RX

  Serial.println("Started");
}
void loop() {
  while (Serial1.available() >= 0) {
    char receivedData = Serial1.read();   // read one byte from serial buffer and save to receivedData
    Serial.print("Received Byte: ");
    Serial.print(receivedData, DEC);  // Print as a decimal value
    Serial.print(" (0x");
    Serial.print(receivedData, HEX);  // Print as a hex value
    Serial.println(")");
    if (receivedData == '1') {
      digitalWrite(LED_BUILTIN, HIGH); // switch LED On
    }
    else if (receivedData == '0') {
      digitalWrite(LED_BUILTIN, LOW);  // switch LED Off
    }
  }

  Serial1.println("asdf");
  delay(1000);
}